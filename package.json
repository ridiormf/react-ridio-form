{
  "name": "react-ridio-form",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo da biblioteca de formulários agnóstica de plataforma.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ridiormf/react-ridio-form",
    "dev": "npm run dev -w playground",
    "test": "npm run test -w @ridiormf/react-ridio-form",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
